config IKASLR
	bool "I-KASLR: continuous re-randomization of built-in kernel code"
	depends on X86_64 || ARM64
	help
	  面向 built-in 内核代码的持续随机化（论文第 3 章）。以固定位置的跳板函数
	  集中代码索引，使一次随机化只需更新 O(1) 个索引；以跳板进出计数精确追踪
	  随机化区域内的执行流，实现无副本随机化。

	  这是 I-KASLR 系统的执行机制层，第 4 章的按需触发与第 5 章的 PA 精准 CFI
	  在其之上展开。

	  实验/研究用途。若不确定，选 N。

config IKASLR_STATS
	bool "I-KASLR runtime statistics"
	depends on IKASLR
	default y
	help
	  在跳板热路径上累计进入次数、最大并发数等统计量。

	  实测这些统计占了跳板开销的绝大部分（§3.6.3），因此测量"生产配置"下的
	  跳板开销时应关掉本项；它与 IKASLR_DEBUG 独立，正是为了能在开着调试
	  接口（/proc/ikaslr/bench）的同时关掉统计。

config IKASLR_COUNT_GLOBAL
	bool "I-KASLR: single shared execution-flow counter (comparison baseline)"
	depends on IKASLR && (ARM64 || X86_64)
	help
	  执行流追踪默认用 SRCU 式的 per-CPU 进入/离开双计数。选中本项后所有核共用
	  同一对计数（同一条缓存行），即「全局共享计数」的对照实现，只用于多核
	  扩展性对比实验。跳板序列由 LLVM pass 按本项生成，切换后须全量重编。

	  若不确定，选 N。

config IKASLR_TRACK_SELFTEST
	bool "I-KASLR: region-empty protocol self-test"
	depends on IKASLR && (ARM64 || X86_64)
	help
	  提供 /proc/ikaslr/track_selftest：写入毫秒数即运行一次判空协议自测——
	  多核并发进出并强制迁移，反复「阻断、判空」，校验从不在区域非空时判为空；
	  同时统计朴素的「每核可加可减计数」方案在同样交错下的误判次数。

config IKASLR_MICROBENCH
	bool "I-KASLR: trampoline micro-benchmark"
	depends on IKASLR && ARM64 && PERF_EVENTS
	help
	  提供 /proc/ikaslr/microbench：读取即运行一次跳板微基准，输出 CSV——
	  跳板各段指令序列的分项成本，以及经真实跳板的调用相对普通调用的差值
	  （纳秒、周期、分支预测失败）。被测的几个随机化函数由 LLVM pass 自动加入
	  名单。数字只有在真机上才有意义。

config IKASLR_DEBUG
	bool "I-KASLR debugging output"
	depends on IKASLR
	help
	  打开 I-KASLR 各阶段的诊断输出（区域边界、指针表、随机化时间分解等）。


config IKASLR_XOM_EPT
	bool "I-KASLR: x86 EPT execute-only memory for leak detection (Chapter 4)"
	depends on IKASLR && X86_64
	help
	  第 4 章 x86 路径：内核自举为嵌套 hypervisor，用 EPT 把随机化区域设为
	  只执行内存（R=0,W=0,X=1）。攻击者对随机化代码的读探测触发 EPT violation，
	  经 MTF 单步"放行一次读"后重新加保护，从而检测泄漏尝试。

	  仅单核（多核 EPT 的物理页全局开窗与 INVEPT shootdown 问题见设计文档；
	  多核场景由 arm64 观察点方案覆盖）。带此配置的内核用于性能测试的 +RD 档时，
	  须以 nr_cpus=1 启动，且对比的其它档也须 nr_cpus=1（见 10-perf-plan.md §2）。

	  需要 CPU 支持 VMX 且 BIOS 已开启虚拟化。研究用途。

config IKASLR_PACFI
	bool "I-KASLR: randomization-assisted ARM PA precise CFI (Chapter 5)"
	depends on IKASLR && ARM64 && ARM64_PTR_AUTH_KERNEL
	help
	  第 5 章：以随机化打断 ARM 指针认证的上下文传播链，对非随机化区域施加
	  精准 CFI。进入随机化区域的间接调用免 PA 验证（区域内地址不可预测天然安全），
	  离开时在 fixed_out 跳板上强制 PA 验证 + 白名单；被多个调用点共享的高扇入
	  函数在运行时识别并移入随机化区域，从而切断传播链。

	  需要 CPU 支持 FEAT_PAuth（QEMU -cpu max 提供）。研究用途。
